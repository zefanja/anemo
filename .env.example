# Database
DATABASE_URL=postgresql://anemo:changeme@localhost:5432/anemo

# Session secret (min. 32 random characters)
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# App
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development

# Frontier heuristic weights (score = transfer_value + curriculum_centrality - COGNITIVE_WEIGHT * cognitive_load)
COGNITIVE_WEIGHT=0.5

# Session limits
SESSION_MAX_TOTAL=20
SESSION_MAX_REVIEW=10
