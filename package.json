{
	"name": "anemo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"import-graph": "tsx scripts/import-graph.ts",
		"generate-explanations": "tsx scripts/generate-explanations.ts",
		"seed": "tsx scripts/seed.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.3",
		"@types/uuid": "^10.0.0",
		"@vitest/ui": "^4.1.8",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"js-yaml": "^4.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"argon2": "^0.44.0",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"ts-fsrs": "^5.4.1",
		"uuid": "^14.0.0"
	}
}
